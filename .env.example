# Resend – for sending contact and job application forms to email
# Sign up at https://resend.com (free tier: 100 emails/day)
# Create an API key and add it here
RESEND_API_KEY=re_xxxxxxxxxxxx

# Optional: Override the recipient email (default: info@sanmarina.edu.np)
# CONTACT_EMAIL=info@sanmarina.edu.np

# Optional: Use your own domain for "From" after verifying with Resend
# Without this, Resend uses onboarding@resend.dev for testing
# RESEND_FROM_EMAIL="San Marina <noreply@sanmarina.edu.np>"
